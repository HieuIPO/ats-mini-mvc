@{
    ViewBag.Title = "Không có quyền";
    var returnUrl = ViewBag.ReturnUrl as string;
    var roleName = Session["AuthRoleName"] as string;
    var isBackOfficeUser = string.Equals(roleName, "Admin", System.StringComparison.OrdinalIgnoreCase)
        || string.Equals(roleName, "HR", System.StringComparison.OrdinalIgnoreCase);
}

<section class="access-denied-section">
    <div class="access-denied-card">
        <span class="eyebrow">403</span>
        <h1>Không có quyền truy cập</h1>
        <p class="text-muted">
            Tài khoản hiện tại không được phép mở chức năng này. Nếu đây là nhầm lẫn,
            vui lòng đăng nhập bằng tài khoản có vai trò phù hợp.
        </p>

        @if (!string.IsNullOrWhiteSpace(returnUrl))
        {
            <p class="small text-muted mb-3">Đường dẫn bị chặn: <code>@returnUrl</code></p>
        }

        <div class="d-flex flex-wrap gap-2">
            @if (isBackOfficeUser)
            {
                <a class="btn btn-primary" href="@Url.Action("Index", "Dashboard")">Về Dashboard</a>
            }
            else
            {
                <a class="btn btn-primary" href="@Url.Action("Login", "Account")">Đăng nhập lại</a>
            }
            <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Home")">Về trang chủ</a>
        </div>
    </div>
</section>
