@{
    ViewBag.Title = "Không có quyền truy cập";
    var returnUrl = ViewBag.ReturnUrl as string;
    var roleName = Session["AuthRoleName"] as string;
    var isBackOfficeUser = string.Equals(roleName, "Admin", System.StringComparison.OrdinalIgnoreCase)
        || string.Equals(roleName, "HR", System.StringComparison.OrdinalIgnoreCase);
}

<section class="access-denied-section">
    <div class="access-denied-card">
        <span class="access-code">403</span>
        <span class="eyebrow">Quyền truy cập bị giới hạn</span>
        <h1>Bạn không thể mở trang này</h1>
        <p>Tài khoản hiện tại không có quyền sử dụng chức năng được yêu cầu. Hãy quay lại khu vực phù hợp với vai trò của bạn.</p>
        @if (!string.IsNullOrWhiteSpace(returnUrl))
        {
            <p class="blocked-path">Đường dẫn bị chặn: <code>@returnUrl</code></p>
        }
        <div class="d-flex flex-wrap gap-2">
            @if (isBackOfficeUser)
            {
                <a class="btn btn-primary" href="@Url.Action("Index", "Dashboard")">Về trang quản trị</a>
            }
            else
            {
                <a class="btn btn-primary" href="@Url.Action("Index", "Candidate")">Về tổng quan ứng viên</a>
            }
            <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Home")">Về trang chủ</a>
        </div>
    </div>
</section>
