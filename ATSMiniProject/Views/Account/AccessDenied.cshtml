@{
    ViewBag.Title = "Khong co quyen";
    var returnUrl = ViewBag.ReturnUrl as string;
    var roleName = Session["AuthRoleName"] as string;
    var isBackOfficeUser = string.Equals(roleName, "Admin", System.StringComparison.OrdinalIgnoreCase)
        || string.Equals(roleName, "HR", System.StringComparison.OrdinalIgnoreCase);
}

<section class="access-denied-section">
    <div class="access-denied-card">
        <span class="eyebrow">403</span>
        <h1>Khong co quyen truy cap</h1>
        <p class="text-muted">
            Tai khoan hien tai khong duoc phep mo chuc nang nay. Neu day la nham lan,
            vui long dang nhap bang tai khoan co vai tro phu hop.
        </p>

        @if (!string.IsNullOrWhiteSpace(returnUrl))
        {
            <p class="small text-muted mb-3">Duong dan bi chan: <code>@returnUrl</code></p>
        }

        <div class="d-flex flex-wrap gap-2">
            @if (isBackOfficeUser)
            {
                <a class="btn btn-primary" href="@Url.Action("Index", "Dashboard")">Ve Dashboard</a>
            }
            else
            {
                <a class="btn btn-primary" href="@Url.Action("Login", "Account")">Dang nhap lai</a>
            }
            <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Home")">Ve trang chu</a>
        </div>
    </div>
</section>
