@{
    Layout = null;
    ViewBag.Title = "Bạn chưa thể mở trang này";

    var roleName = Session["AuthRoleName"] as string;
    var isBackOfficeUser = string.Equals(roleName, "Admin", System.StringComparison.OrdinalIgnoreCase)
        || string.Equals(roleName, "HR", System.StringComparison.OrdinalIgnoreCase);
    var primaryUrl = isBackOfficeUser
        ? Url.Action("Index", "Dashboard")
        : Url.Action("Index", "Home");
}

<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - ATS Mini</title>
    <link rel="icon" type="image/png" sizes="64x64" href="@Url.Content("~/Content/images/brand/ats-mini-favicon.png")" />
    <link href="@Url.Content("~/Content/css/access-denied.css")?v=20260726-1" rel="stylesheet" />
</head>
<body>
    <a class="skip-link" href="#access-denied-content">Bỏ qua nội dung phụ</a>

    <main class="access-denied-page" id="access-denied-content">
        <section class="access-denied-shell" aria-labelledby="access-denied-title">
            <div class="access-denied-copy">
                <p class="access-denied-code">403</p>
                <h1 id="access-denied-title">Bạn chưa thể mở trang này</h1>
                <p class="access-denied-message">
                    Tài khoản hiện tại chưa có vai trò phù hợp để truy cập chức năng này. Bạn có thể quay về khu vực an toàn hoặc đăng nhập bằng tài khoản khác.
                </p>
                <div class="access-denied-actions" aria-label="Hành động tiếp theo">
                    <a class="access-denied-button access-denied-button-primary" href="@primaryUrl">Về trang phù hợp</a>
                    <a class="access-denied-button access-denied-button-secondary" href="@Url.Action("Login", "Account")">Đăng nhập tài khoản khác</a>
                </div>
            </div>

            <div class="access-denied-visual">
                <img src="@Url.Content("~/Content/images/errors/access-denied-door.png")"
                     alt="" aria-hidden="true" />
            </div>
        </section>
    </main>
</body>
</html>
