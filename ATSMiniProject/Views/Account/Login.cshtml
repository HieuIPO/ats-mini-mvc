@model ATSMiniProject.ViewModels.Account.LoginViewModel

@{
    ViewBag.Title = "Dang nhap";
}

<section class="auth-section">
    <div class="auth-card">
        <h1>Dang nhap</h1>
        <p class="text-muted">Truy cap khu vuc quan tri ATS Mini.</p>

        @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "auth-form", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ReturnUrl)

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="mb-3">
                @Html.LabelFor(model => model.Username, new { @class = "form-label" })
                @Html.TextBoxFor(model => model.Username, new { @class = "form-control", autocomplete = "username", autofocus = "autofocus" })
                @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.Password, new { @class = "form-label" })
                @Html.PasswordFor(model => model.Password, new { @class = "form-control", autocomplete = "current-password" })
                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger small" })
            </div>
            <button class="btn btn-primary w-100" type="submit">Dang nhap</button>
        }

        <div class="auth-hint text-muted small mt-3">
            Tai khoan demo: <strong>admin</strong> / <strong>123456</strong> hoac <strong>hr01</strong> / <strong>123456</strong>
        </div>
    </div>
</section>
