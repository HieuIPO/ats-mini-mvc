@{
    ViewBag.Title = "Dang nhap";
}

<section class="auth-section">
    <div class="auth-card">
        <h1>Dang nhap</h1>
        <p class="text-muted">Truy cap khu vuc quan tri ATS Mini.</p>
        <form>
            <div class="mb-3">
                <label class="form-label" for="username">Ten dang nhap</label>
                <input class="form-control" id="username" name="username" autocomplete="username" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">Mat khau</label>
                <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" />
            </div>
            <button class="btn btn-primary w-100" type="submit">Dang nhap</button>
        </form>
    </div>
</section>
