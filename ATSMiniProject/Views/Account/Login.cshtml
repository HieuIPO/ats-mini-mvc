@model ATSMiniProject.ViewModels.Account.LoginViewModel

@{
    Layout = null;
    ViewBag.Title = "Đăng nhập";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập - ATS Mini</title>
    <link href="~/Content/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <style>
        :root {
            --ats-primary: #2563eb;
            --ats-primary-dark: #1d4ed8;
            --ats-green: #03a69a;
            --ats-ink: #132d2b;
            --ats-muted: #667085;
            --ats-border: #dbe6f2;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: 28px;
            color: #111827;
            font-family: "Segoe UI", Arial, sans-serif;
            background:
                radial-gradient(circle at 12% 18%, rgba(3, 166, 154, 0.18), transparent 28%),
                radial-gradient(circle at 88% 18%, rgba(37, 99, 235, 0.16), transparent 28%),
                linear-gradient(135deg, #f4fbff 0%, #eef5f8 46%, #f8fafc 100%);
        }

        .login-card {
            width: min(100%, 980px);
            min-height: 560px;
            display: grid;
            grid-template-columns: 0.95fr 1.05fr;
            overflow: hidden;
            background: #ffffff;
            border: 1px solid rgba(219, 230, 242, 0.9);
            border-radius: 24px;
            box-shadow: 0 26px 70px rgba(19, 45, 43, 0.16);
        }

        .login-brand {
            position: relative;
            isolation: isolate;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 48px;
            color: #ffffff;
            background: linear-gradient(150deg, #132d2b 0%, #0f6f69 58%, #2563eb 100%);
        }

        .login-brand::before,
        .login-brand::after {
            content: "";
            position: absolute;
            z-index: -1;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.18);
        }

        .login-brand::before {
            width: 330px;
            height: 330px;
            top: -122px;
            right: -96px;
        }

        .login-brand::after {
            width: 190px;
            height: 190px;
            left: -72px;
            bottom: -58px;
        }

        .brand-logo {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
        }

        .brand-mark {
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            border-radius: 16px;
            background: #ffffff;
            color: var(--ats-green);
            box-shadow: 0 12px 26px rgba(0, 0, 0, 0.14);
        }

        .brand-copy span {
            display: block;
            color: rgba(255, 255, 255, 0.74);
            font-size: 0.82rem;
            font-weight: 600;
        }

        .brand-title {
            max-width: 360px;
            margin: 42px 0 0;
        }

        .brand-title h1 {
            margin: 0 0 14px;
            font-size: 2.28rem;
            line-height: 1.1;
            font-weight: 800;
        }

        .brand-title p {
            margin: 0;
            color: rgba(255, 255, 255, 0.82);
            line-height: 1.75;
        }

        .brand-feature-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
            margin-top: 34px;
        }

        .brand-feature {
            min-height: 58px;
            display: block;
            padding: 12px 8px 10px;
            border-top: 3px solid rgba(255, 255, 255, 0.82);
            background: rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            text-decoration: none;
            transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
        }

        .brand-feature:hover,
        .brand-feature:focus {
            transform: translateY(-2px);
            background: rgba(255, 255, 255, 0.14);
            border-top-color: #ffffff;
            text-decoration: none;
            outline: none;
        }

        .brand-feature strong {
            display: block;
            color: #ffffff;
            font-size: 0.8rem;
            line-height: 1.25;
            white-space: nowrap;
        }

        .brand-feature span {
            display: block;
            margin-top: 4px;
            color: rgba(255, 255, 255, 0.72);
            font-size: 0.72rem;
        }

        .brand-footer {
            color: rgba(255, 255, 255, 0.72);
            font-size: 0.86rem;
        }

        .login-form-side {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 54px 66px;
        }

        .login-form-wrap {
            width: 100%;
            max-width: 390px;
        }

        .form-kicker {
            display: inline-block;
            margin-bottom: 12px;
            color: var(--ats-primary);
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 0;
            text-transform: uppercase;
        }

        .login-form-wrap h2 {
            margin: 0 0 8px;
            color: var(--ats-ink);
            font-size: 2rem;
            line-height: 1.12;
            font-weight: 750;
        }

        .login-form-wrap > p {
            margin: 0 0 28px;
            color: var(--ats-muted);
            line-height: 1.6;
        }

        .field-group {
            margin-bottom: 16px;
        }

        .field-group label {
            display: block;
            margin-bottom: 8px;
            color: #1f2937;
            font-size: 0.92rem;
            font-weight: 700;
        }

        .login-input {
            width: 100%;
            height: 48px;
            padding: 0 18px;
            color: #111827;
            border: 1px solid var(--ats-border);
            border-radius: 999px;
            background: #f7fbff;
            outline: none;
            transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
        }

        .login-input:focus {
            border-color: var(--ats-primary);
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.11);
        }

        .login-meta {
            display: flex;
            justify-content: flex-end;
            margin: 2px 0 20px;
            color: var(--ats-muted);
            font-size: 0.86rem;
        }

        .login-button {
            width: 100%;
            height: 48px;
            border: 0;
            border-radius: 999px;
            color: #ffffff;
            background: linear-gradient(135deg, var(--ats-primary), var(--ats-green));
            font-weight: 800;
            box-shadow: 0 12px 24px rgba(37, 99, 235, 0.2);
            transition: transform 0.18s ease, box-shadow 0.18s ease;
        }

        .login-button:hover,
        .login-button:focus {
            transform: translateY(-1px);
            box-shadow: 0 16px 30px rgba(37, 99, 235, 0.25);
        }

        .demo-box {
            margin-top: 20px;
            padding: 14px 16px;
            color: #334155;
            background: #f4f8fb;
            border: 1px solid var(--ats-border);
            border-radius: 16px;
            font-size: 0.9rem;
            line-height: 1.7;
        }

        .demo-box strong {
            color: var(--ats-ink);
        }

        .validation-summary-errors {
            margin-bottom: 18px;
            padding: 12px 14px;
            color: #b42318;
            background: #fff4f2;
            border: 1px solid #ffd6d1;
            border-radius: 14px;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }

        .field-validation-error {
            display: block;
            margin-top: 6px;
            color: #b42318;
            font-size: 0.84rem;
        }

        @@media (max-width: 820px) {
            body {
                padding: 18px;
            }

            .login-card {
                grid-template-columns: 1fr;
                border-radius: 22px;
            }

            .login-brand {
                min-height: 330px;
                padding: 34px;
            }

            .login-form-side {
                padding: 38px 28px;
            }

            .brand-feature-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <main class="login-card">
        <section class="login-brand" aria-label="ATS Mini">
            <div>
                <div class="brand-logo">
                    <div class="brand-mark">ATS</div>
                    <div class="brand-copy">
                        ATS Mini
                        <span>Hệ thống tuyển dụng nội bộ</span>
                    </div>
                </div>

                <div class="brand-title">
                    <h1>Chào mừng trở lại</h1>
                    <p>Đăng nhập để quản lý tin tuyển dụng, theo dõi hồ sơ ứng viên và điều phối lịch phỏng vấn trong công ty.</p>
                </div>

                <div class="brand-feature-grid" aria-label="Các phân hệ chính">
                    <a class="brand-feature" href="@Url.Action("Index", "Jobs")">
                        <strong>Tin tuyển dụng</strong>
                        <span>Quản lý vị trí</span>
                    </a>
                    <a class="brand-feature" href="@Url.Action("Index", "Applications")">
                        <strong>Ứng viên</strong>
                        <span>Theo dõi hồ sơ</span>
                    </a>
                    <a class="brand-feature" href="@Url.Action("Index", "Interviews")">
                        <strong>Phỏng vấn</strong>
                        <span>Sắp lịch nội bộ</span>
                    </a>
                </div>
            </div>

            <div class="brand-footer">Dành cho Admin và HR</div>
        </section>

        <section class="login-form-side">
            <div class="login-form-wrap">
                <span class="form-kicker">Khu vực quản trị</span>
                <h2>Đăng nhập</h2>
                <p>Vui lòng dùng tài khoản Admin hoặc HR để tiếp tục.</p>

                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.ReturnUrl)
                    @Html.ValidationSummary(true, "", new { @class = "" })

                    <div class="field-group">
                        @Html.LabelFor(model => model.Username)
            @Html.TextBoxFor(model => model.Username, new { @class = "login-input", autocomplete = "username", placeholder = "Nhập tên đăng nhập" })
                        @Html.ValidationMessageFor(model => model.Username, "", new { @class = "" })
                    </div>

                    <div class="field-group">
                        @Html.LabelFor(model => model.Password)
                        @Html.PasswordFor(model => model.Password, new { @class = "login-input", autocomplete = "current-password", placeholder = "Nhập mật khẩu" })
                        @Html.ValidationMessageFor(model => model.Password, "", new { @class = "" })
                    </div>

                    <div class="login-meta">Demo: hr01 / 123456</div>
                    <button class="login-button" type="submit">Đăng nhập</button>
                }

                <div class="demo-box">
                    Tài khoản demo: <strong>admin</strong> / <strong>123456</strong> hoặc <strong>hr01</strong> / <strong>123456</strong>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
