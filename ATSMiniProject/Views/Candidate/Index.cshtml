@model ATSMiniProject.ViewModels.Candidate.CandidateDashboardViewModel

@{
    ViewBag.Title = "Tổng quan ứng viên";
}

<section class="candidate-dashboard-hero">
    <div class="container candidate-dashboard-hero-inner">
        <div>
            <span class="dashboard-kicker">Không gian ứng viên</span>
            <h1>Chào @Model.FullName,</h1>
            <p>Hành trình nghề nghiệp của bạn đang được cập nhật tại đây.</p>
        </div>
        <div class="dashboard-hero-actions">
            <a class="btn btn-light" href="@Url.Action("Index", "Jobs")">Tìm cơ hội mới</a>
            <a class="btn btn-outline-light" href="@Url.Action("Profile", "Candidate")">Cập nhật hồ sơ</a>
        </div>
    </div>
</section>

<section class="candidate-metrics">
    <div class="container candidate-metrics-grid">
        <div>
            <span>Hồ sơ đã nộp</span>
            <strong>@Model.TotalApplications.ToString("D2")</strong>
        </div>
        <div>
            <span>Đang trong quy trình</span>
            <strong>@Model.ActiveApplications.ToString("D2")</strong>
        </div>
        <div>
            <span>Lịch phỏng vấn sắp tới</span>
            <strong>@Model.UpcomingInterviews.ToString("D2")</strong>
            @if (Model.NextInterviewDate.HasValue)
            {
                <small>@Model.NextInterviewDate.Value.ToString("dd/MM/yyyy HH:mm")</small>
            }
        </div>
    </div>
</section>

<section class="candidate-dashboard-content">
    <div class="container">
        @if (!Model.IsProfileComplete)
        {
            <div class="profile-completion-alert">
                <div>
                    <strong>Hoàn thiện hồ sơ để ứng tuyển nhanh hơn</strong>
                    <span>Bổ sung đầy đủ họ tên, email và số điện thoại của bạn.</span>
                </div>
                <a href="@Url.Action("Profile", "Candidate")">Hoàn thiện hồ sơ</a>
            </div>
        }

        <div class="candidate-dashboard-grid">
            <section class="dashboard-section">
                <div class="dashboard-section-heading">
                    <div>
                        <span class="eyebrow">Tiến trình gần đây</span>
                        <h2>Hồ sơ ứng tuyển</h2>
                    </div>
                    <a href="@Url.Action("Status", "Applications")">Xem tất cả</a>
                </div>

                @if (Model.RecentApplications.Count == 0)
                {
                    <div class="candidate-empty candidate-empty-compact">
                        <h3>Bạn chưa nộp hồ sơ nào</h3>
                        <p>Khám phá các vị trí đang tuyển và bắt đầu hành trình mới.</p>
                        <a class="btn btn-primary" href="@Url.Action("Index", "Jobs")">Xem việc làm</a>
                    </div>
                }
                else
                {
                    <div class="dashboard-application-list">
                        @foreach (var application in Model.RecentApplications)
                        {
                            <a class="dashboard-application-item" href="@Url.Action("Details", "Applications", new { id = application.ApplicationId })">
                                <span class="status-marker @(application.IsFinal ? "is-final" : null)"></span>
                                <span class="dashboard-application-copy">
                                    <strong>@application.JobTitle</strong>
                                    <small>@application.DepartmentName · Nộp ngày @application.AppliedDate.ToString("dd/MM/yyyy")</small>
                                </span>
                                <span class="status-badge @(application.IsFinal ? "status-final" : null)">@application.StatusName</span>
                                <span class="dashboard-row-arrow" aria-hidden="true">→</span>
                            </a>
                        }
                    </div>
                }
            </section>

            <aside class="dashboard-section recommended-section">
                <div class="dashboard-section-heading">
                    <div>
                        <span class="eyebrow">Dành cho bạn</span>
                        <h2>Cơ hội chưa ứng tuyển</h2>
                    </div>
                </div>
                @if (Model.RecommendedJobs.Count == 0)
                {
                    <p class="text-muted">Bạn đã ứng tuyển tất cả vị trí đang mở.</p>
                }
                else
                {
                    foreach (var job in Model.RecommendedJobs)
                    {
                        <a class="recommended-job-item" href="@Url.Action("Details", "Jobs", new { id = job.JobId })">
                            <span>@job.JobType</span>
                            <strong>@job.Title</strong>
                            <small>@job.Location · @job.SalaryRange</small>
                        </a>
                    }
                }
            </aside>
        </div>
    </div>
</section>
