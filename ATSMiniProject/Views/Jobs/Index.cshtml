@model ATSMiniProject.ViewModels.Jobs.JobSearchViewModel
@using ATSMiniProject.Helpers

@{
    ViewBag.Title = "Việc làm";
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Keyword)
        || !string.IsNullOrWhiteSpace(Model.Location)
        || !string.IsNullOrWhiteSpace(Model.JobType)
        || Model.DepartmentId.HasValue;
    var isLoggedIn = Session[AuthSessionKeys.UserID] != null;
    var isCandidate = string.Equals(
        Session[AuthSessionKeys.RoleName] as string,
        "Candidate",
        StringComparison.OrdinalIgnoreCase);
}

@using (Html.BeginForm("Index", "Jobs", FormMethod.Get, new { @class = "career-search-form", role = "search" }))
{
    <section class="career-search-hero" aria-labelledby="jobs-page-title">
        <div class="career-search-hero-overlay"></div>
        <div class="container career-search-hero-content">
            <span class="career-search-kicker">Cơ hội nghề nghiệp tại ATS Mini</span>
            <h1 id="jobs-page-title">Tìm kiếm công việc</h1>
            <p>Chọn vị trí phù hợp với kinh nghiệm, định hướng và nơi bạn muốn làm việc.</p>
            <div class="career-search-box">
                <span class="career-search-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <circle cx="10.5" cy="10.5" r="6.5"></circle>
                        <path d="m15.5 15.5 5 5"></path>
                    </svg>
                </span>
                <label class="visually-hidden" for="keyword">Tìm theo tên công việc, vị trí hoặc lĩnh vực</label>
                <input id="keyword"
                       name="keyword"
                       value="@Model.Keyword"
                       placeholder="Bạn đang tìm kiếm công việc gì?"
                       autocomplete="off" />
                <button type="submit">Tìm kiếm</button>
            </div>
        </div>
    </section>

    <section class="career-search-section">
        <div class="container">
            <div class="career-search-layout">
                <aside class="career-filter-column" aria-labelledby="filter-title">
                    <div class="career-filter-panel">
                        <div class="career-filter-heading">
                            <div>
                                <span class="career-filter-label">Bộ lọc</span>
                                <h2 id="filter-title">Thu hẹp kết quả</h2>
                            </div>
                            @if (hasFilters)
                            {
                                <a href="@Url.Action("Index", "Jobs")">Xóa tất cả</a>
                            }
                        </div>

                        <div class="career-filter-group">
                            <label for="departmentId">Phòng ban</label>
                            @Html.DropDownListFor(
                                model => model.DepartmentId,
                                Model.Departments,
                                "Tất cả phòng ban",
                                new { @class = "form-select", id = "departmentId" }
                            )
                        </div>

                        <div class="career-filter-group">
                            <label for="jobType">Loại công việc</label>
                            @Html.DropDownList(
                                "jobType",
                                Model.JobTypes,
                                "Tất cả loại công việc",
                                new { @class = "form-select", id = "jobType" }
                            )
                        </div>

                        <div class="career-filter-group">
                            <label for="location">Địa điểm</label>
                            @Html.DropDownList(
                                "location",
                                Model.Locations,
                                "Tất cả địa điểm",
                                new { @class = "form-select", id = "location" }
                            )
                        </div>

                        <button class="career-filter-submit" type="submit">Áp dụng bộ lọc</button>
                    </div>

                    <div class="talent-profile-card">
                        <span class="talent-profile-mark" aria-hidden="true">A</span>
                        <span class="career-filter-label">Hồ sơ ứng viên</span>
                        <h2>Sẵn sàng cho cơ hội tiếp theo?</h2>
                        <p>Tạo tài khoản để nộp CV và theo dõi tiến trình ứng tuyển trên cùng một hệ thống.</p>
                        <a href="@Url.Action("Register", "Account")">
                            Tạo hồ sơ <span aria-hidden="true">→</span>
                        </a>
                    </div>
                </aside>

                <div class="career-results">
                    <header class="career-results-header">
                        <div>
                            <span class="career-filter-label">Danh sách vị trí</span>
                            <h2>@Model.TotalItems công việc đang tuyển</h2>
                        </div>
                        @if (hasFilters)
                        {
                            <span class="career-results-note">Kết quả theo bộ lọc của bạn</span>
                        }
                        else
                        {
                            <span class="career-results-note">Sắp xếp theo hạn nộp gần nhất</span>
                        }
                    </header>

                    @if (Model.Jobs.Count == 0)
                    {
                        <div class="career-empty-state">
                            <span aria-hidden="true">⌕</span>
                            <h2>Chưa tìm thấy vị trí phù hợp</h2>
                            <p>Hãy thử một từ khóa khác hoặc mở rộng phòng ban, loại công việc và địa điểm.</p>
                            <a href="@Url.Action("Index", "Jobs")">Xem tất cả việc làm</a>
                        </div>
                    }
                    else
                    {
                        <div class="career-job-list">
                            @foreach (var job in Model.Jobs)
                            {
                                var summary = string.IsNullOrWhiteSpace(job.Summary)
                                    ? "Khám phá mô tả công việc, yêu cầu chuyên môn và cơ hội phát triển tại ATS Mini."
                                    : job.Summary.Trim();
                                if (summary.Length > 220)
                                {
                                    summary = summary.Substring(0, 217) + "...";
                                }
                                var isUrgent = job.Deadline.HasValue
                                    && (job.Deadline.Value.Date - DateTime.Today).TotalDays <= 7;

                                <article class="career-job-item">
                                    <div class="career-job-main">
                                        <div class="career-job-eyebrow">
                                            <span class="career-job-location">
                                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                                    <path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11Z"></path>
                                                    <circle cx="12" cy="10" r="2"></circle>
                                                </svg>
                                                @(job.Location ?? "Địa điểm thỏa thuận")
                                            </span>
                                            <span>@job.DepartmentName</span>
                                        </div>

                                        <h2>
                                            <a href="@Url.Action("Details", "Jobs", new { id = job.JobId })">@job.Title</a>
                                        </h2>
                                        <p class="career-job-summary">@summary</p>

                                        <dl class="career-job-meta">
                                            <div>
                                                <dt>Vị trí</dt>
                                                <dd>@job.PositionName</dd>
                                            </div>
                                            <div>
                                                <dt>Loại hình</dt>
                                                <dd>@(job.JobType ?? "Thỏa thuận")</dd>
                                            </div>
                                            <div>
                                                <dt>Mức lương</dt>
                                                <dd>@(job.SalaryRange ?? "Thỏa thuận")</dd>
                                            </div>
                                            <div class="@(isUrgent ? "career-job-deadline is-urgent" : "career-job-deadline")">
                                                <dt>Hạn nộp</dt>
                                                <dd>@(job.Deadline.HasValue ? job.Deadline.Value.ToString("dd/MM/yyyy") : "Không giới hạn")</dd>
                                            </div>
                                        </dl>
                                    </div>

                                    <div class="career-job-actions">
                                        @if (isCandidate)
                                        {
                                            var savedFormId = "job-save-form-" + job.JobId;
                                            <button class="job-save-button job-save-button-icon-only @(job.IsSaved ? "is-saved" : null)"
                                                    type="submit"
                                                    form="@savedFormId"
                                                    aria-pressed="@(job.IsSaved ? "true" : "false")"
                                                    data-job-title="@job.Title"
                                                    title="@(job.IsSaved ? "Bỏ lưu tin" : "Lưu tin")"
                                                    aria-label="@(job.IsSaved ? "Bỏ lưu tin " : "Lưu tin ")@job.Title">
                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5S4.5 16.2 4.5 9.8A4.3 4.3 0 0 1 12 6.9a4.3 4.3 0 0 1 7.5 2.9C19.5 16.2 12 20.5 12 20.5Z"></path></svg>
                                                <span class="visually-hidden">@(job.IsSaved ? "Bỏ lưu" : "Lưu tin")</span>
                                            </button>
                                        }
                                        else if (!isLoggedIn)
                                        {
                                            <a class="job-save-button job-save-button-icon-only"
                                               href="@Url.Action("Login", "Account", new { returnUrl = Request.RawUrl })"
                                               title="Lưu tin"
                                               aria-label="Đăng nhập để lưu tin @job.Title">
                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5S4.5 16.2 4.5 9.8A4.3 4.3 0 0 1 12 6.9a4.3 4.3 0 0 1 7.5 2.9C19.5 16.2 12 20.5 12 20.5Z"></path></svg>
                                                <span class="visually-hidden">Lưu tin</span>
                                            </a>
                                        }

                                        <a class="career-job-action"
                                           href="@Url.Action("Details", "Jobs", new { id = job.JobId })"
                                           aria-label="Xem chi tiết công việc @job.Title">
                                            Xem chi tiết <span aria-hidden="true">→</span>
                                        </a>
                                    </div>
                                </article>
                            }
                        </div>

                        if (Model.TotalPages > 1)
                        {
                            <nav class="candidate-pagination" aria-label="Phân trang việc làm">
                                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                                {
                                    <a class="@(pageNumber == Model.Page ? "active" : null)"
                                       aria-current="@(pageNumber == Model.Page ? "page" : null)"
                                       href="@Url.Action("Index", "Jobs", new { keyword = Model.Keyword, location = Model.Location, jobType = Model.JobType, departmentId = Model.DepartmentId, page = pageNumber })">
                                        @pageNumber
                                    </a>
                                }
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>
    </section>
}

@if (isCandidate)
{
    foreach (var job in Model.Jobs)
    {
        var savedFormId = "job-save-form-" + job.JobId;
        using (Html.BeginForm(
            job.IsSaved ? "UnsaveJob" : "SaveJob",
            "Jobs",
            FormMethod.Post,
            new
            {
                id = savedFormId,
                @class = "job-save-external-form",
                data_saved_job_form = "true",
                data_save_url = Url.Action("SaveJob", "Jobs"),
                data_unsave_url = Url.Action("UnsaveJob", "Jobs")
            }))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("jobId", job.JobId)
            @Html.Hidden("returnUrl", Request.RawUrl)
        }
    }
}
