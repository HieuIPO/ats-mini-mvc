@model ATSMiniProject.ViewModels.Jobs.JobFilterViewModel
@{
    ViewBag.Title = "Quản lý tin tuyển dụng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var today = DateTime.Today;
    var expiringThrough = today.AddDays(7);
    var hasAdvancedFilters = Model.DepartmentID.HasValue ||
                             Model.JobPositionID.HasValue ||
                             !string.IsNullOrWhiteSpace(Model.Location) ||
                             !string.IsNullOrWhiteSpace(Model.JobType);
    var hasFilters = hasAdvancedFilters ||
                     !string.IsNullOrWhiteSpace(Model.Keyword) ||
                     !string.IsNullOrWhiteSpace(Model.Status);
    var selectedDepartment = System.Linq.Enumerable.FirstOrDefault(Model.Departments, item => item.Selected);
    var selectedPosition = System.Linq.Enumerable.FirstOrDefault(Model.JobPositions, item => item.Selected);
    var selectedLocation = System.Linq.Enumerable.FirstOrDefault(Model.Locations, item => item.Selected);
    var selectedJobType = System.Linq.Enumerable.FirstOrDefault(Model.JobTypes, item => item.Selected);
    var statusLabel = Model.Status == "open" ? "Đang mở" :
                      Model.Status == "expiring" ? "Sắp hết hạn" :
                      Model.Status == "closed" ? "Đã đóng" :
                      Model.Status == "expired" ? "Hết hạn" : null;
}

<header class="page-header jobs-page-header">
    <div>
        <span class="jobs-page-eyebrow">Không gian tuyển dụng</span>
        <h1>Tin tuyển dụng</h1>
        <p>Theo dõi trạng thái, hạn nộp và hồ sơ ứng viên của từng tin tuyển dụng.</p>
    </div>
    <a class="btn btn-primary jobs-create-button" href="@Url.Action("Create", "Jobs")">
        <span aria-hidden="true">+</span>
        Tạo tin tuyển dụng
    </a>
</header>

<nav class="jobs-status-nav" aria-label="Lọc nhanh theo trạng thái tin tuyển dụng">
    <a class="jobs-status-item @(string.IsNullOrWhiteSpace(Model.Status) ? "is-active" : "")"
       href="@Url.Action("AdminIndex", "Jobs", new { sort = Model.Sort })">
        <span>Tất cả</span>
        <strong>@Model.TotalJobs</strong>
        <small>Toàn bộ tin tuyển dụng</small>
    </a>
    <a class="jobs-status-item status-open @(Model.Status == "open" ? "is-active" : "")"
       href="@Url.Action("AdminIndex", "Jobs", new { status = "open", sort = Model.Sort })">
        <span>Đang mở</span>
        <strong>@Model.OpenJobs</strong>
        <small>Đang nhận hồ sơ</small>
    </a>
    <a class="jobs-status-item status-expiring @(Model.Status == "expiring" ? "is-active" : "")"
       href="@Url.Action("AdminIndex", "Jobs", new { status = "expiring", sort = Model.Sort })">
        <span>Sắp hết hạn</span>
        <strong>@Model.ExpiringJobs</strong>
        <small>Trong vòng 7 ngày</small>
    </a>
    <a class="jobs-status-item status-closed @(Model.Status == "closed" ? "is-active" : "")"
       href="@Url.Action("AdminIndex", "Jobs", new { status = "closed", sort = Model.Sort })">
        <span>Đã đóng</span>
        <strong>@Model.ClosedJobs</strong>
        <small>Đóng trước hạn</small>
    </a>
    <a class="jobs-status-item status-expired @(Model.Status == "expired" ? "is-active" : "")"
       href="@Url.Action("AdminIndex", "Jobs", new { status = "expired", sort = Model.Sort })">
        <span>Hết hạn</span>
        <strong>@Model.ExpiredJobs</strong>
        <small>Đã qua hạn nộp</small>
    </a>
</nav>

<section class="jobs-filter-panel" aria-labelledby="jobs-filter-heading">
    <h2 id="jobs-filter-heading" class="visually-hidden">Bộ lọc tin tuyển dụng</h2>
    @using (Html.BeginForm("AdminIndex", "Jobs", FormMethod.Get, new { @class = "jobs-filter-form" }))
    {
        @Html.Hidden("sort", Model.Sort)
        <div class="jobs-filter-main">
            <div class="jobs-search-field">
                <label class="visually-hidden" for="job-keyword">Tìm kiếm tin tuyển dụng</label>
                <span aria-hidden="true">⌕</span>
                @Html.TextBox("keyword", Model.Keyword, new
                {
                    @class = "form-control",
                    id = "job-keyword",
                    type = "search",
                    placeholder = "Tìm theo tiêu đề, mô tả, yêu cầu..."
                })
            </div>
            <label class="visually-hidden" for="job-status">Trạng thái</label>
            <select class="form-select" id="job-status" name="status">
                <option value="">Tất cả trạng thái</option>
                <option value="open" @(Model.Status == "open" ? "selected" : "")>Đang mở</option>
                <option value="expiring" @(Model.Status == "expiring" ? "selected" : "")>Sắp hết hạn</option>
                <option value="closed" @(Model.Status == "closed" ? "selected" : "")>Đã đóng</option>
                <option value="expired" @(Model.Status == "expired" ? "selected" : "")>Hết hạn</option>
            </select>
            <button class="btn btn-primary" type="submit">Lọc kết quả</button>
            @if (hasFilters)
            {
                <a class="btn btn-outline-secondary" href="@Url.Action("AdminIndex", "Jobs", new { sort = Model.Sort })">Xóa lọc</a>
            }
        </div>

        <details class="jobs-advanced-filter" @(hasAdvancedFilters ? "open" : "")>
            <summary>
                Bộ lọc nâng cao
                @if (hasAdvancedFilters)
                {
                    <span>Đang áp dụng</span>
                }
            </summary>
            <div class="jobs-advanced-grid">
                <div class="filter-field">
                    <label for="job-department">Phòng ban</label>
                    @Html.DropDownList("departmentId", Model.Departments, "Tất cả phòng ban", new { @class = "form-select", id = "job-department" })
                </div>
                <div class="filter-field">
                    <label for="job-position">Vị trí</label>
                    @Html.DropDownList("jobPositionId", Model.JobPositions, "Tất cả vị trí", new { @class = "form-select", id = "job-position" })
                </div>
                <div class="filter-field">
                    <label for="job-location">Địa điểm</label>
                    @Html.DropDownList("location", Model.Locations, "Tất cả địa điểm", new { @class = "form-select", id = "job-location" })
                </div>
                <div class="filter-field">
                    <label for="job-type">Loại công việc</label>
                    @Html.DropDownList("jobType", Model.JobTypes, "Tất cả loại công việc", new { @class = "form-select", id = "job-type" })
                </div>
            </div>
        </details>
    }

    @if (hasFilters)
    {
        <div class="jobs-active-filters" aria-label="Các bộ lọc đang áp dụng">
            <span class="jobs-active-label">Đang lọc:</span>
            @if (!string.IsNullOrWhiteSpace(Model.Keyword))
            {
                <a href="@Url.Action("AdminIndex", "Jobs", new { departmentId = Model.DepartmentID, jobPositionId = Model.JobPositionID, location = Model.Location, jobType = Model.JobType, status = Model.Status, sort = Model.Sort })">
                    Từ khóa: @Model.Keyword <span aria-hidden="true">×</span>
                </a>
            }
            @if (statusLabel != null)
            {
                <a href="@Url.Action("AdminIndex", "Jobs", new { keyword = Model.Keyword, departmentId = Model.DepartmentID, jobPositionId = Model.JobPositionID, location = Model.Location, jobType = Model.JobType, sort = Model.Sort })">
                    @statusLabel <span aria-hidden="true">×</span>
                </a>
            }
            @if (selectedDepartment != null)
            {
                <a href="@Url.Action("AdminIndex", "Jobs", new { keyword = Model.Keyword, jobPositionId = Model.JobPositionID, location = Model.Location, jobType = Model.JobType, status = Model.Status, sort = Model.Sort })">
                    @selectedDepartment.Text <span aria-hidden="true">×</span>
                </a>
            }
            @if (selectedPosition != null)
            {
                <a href="@Url.Action("AdminIndex", "Jobs", new { keyword = Model.Keyword, departmentId = Model.DepartmentID, location = Model.Location, jobType = Model.JobType, status = Model.Status, sort = Model.Sort })">
                    @selectedPosition.Text <span aria-hidden="true">×</span>
                </a>
            }
            @if (selectedLocation != null)
            {
                <a href="@Url.Action("AdminIndex", "Jobs", new { keyword = Model.Keyword, departmentId = Model.DepartmentID, jobPositionId = Model.JobPositionID, jobType = Model.JobType, status = Model.Status, sort = Model.Sort })">
                    @selectedLocation.Text <span aria-hidden="true">×</span>
                </a>
            }
            @if (selectedJobType != null)
            {
                <a href="@Url.Action("AdminIndex", "Jobs", new { keyword = Model.Keyword, departmentId = Model.DepartmentID, jobPositionId = Model.JobPositionID, location = Model.Location, status = Model.Status, sort = Model.Sort })">
                    @selectedJobType.Text <span aria-hidden="true">×</span>
                </a>
            }
        </div>
    }
</section>

<section class="ats-table-card job-management-card" aria-labelledby="jobs-list-heading">
    <div class="jobs-list-toolbar">
        <div>
            <h2 id="jobs-list-heading">Danh sách tin tuyển dụng</h2>
            <p>Đang xem <strong>@Model.FirstItem–@Model.LastItem</strong> trên @Model.FilteredJobs kết quả lọc, tổng cộng @Model.TotalJobs tin</p>
        </div>
        @using (Html.BeginForm("AdminIndex", "Jobs", FormMethod.Get, new { @class = "jobs-sort-form" }))
        {
            @Html.Hidden("keyword", Model.Keyword)
            @Html.Hidden("departmentId", Model.DepartmentID)
            @Html.Hidden("jobPositionId", Model.JobPositionID)
            @Html.Hidden("location", Model.Location)
            @Html.Hidden("jobType", Model.JobType)
            @Html.Hidden("status", Model.Status)
            <label for="job-sort">Sắp xếp</label>
            <select class="form-select" id="job-sort" name="sort" onchange="this.form.submit()">
                <option value="deadline" @(Model.Sort == "deadline" ? "selected" : "")>Gần hết hạn</option>
                <option value="applications" @(Model.Sort == "applications" ? "selected" : "")>Nhiều hồ sơ nhất</option>
                <option value="newest" @(Model.Sort == "newest" ? "selected" : "")>Mới tạo gần đây</option>
            </select>
        }
    </div>

    @if (!System.Linq.Enumerable.Any(Model.Jobs))
    {
        <div class="jobs-empty-state" role="status">
            <span class="jobs-empty-icon" aria-hidden="true">⌕</span>
            <h3>Không tìm thấy tin tuyển dụng</h3>
            <p>Thử thay đổi từ khóa hoặc bỏ bớt bộ lọc đang áp dụng.</p>
            @if (hasFilters)
            {
                <a class="btn btn-outline-primary" href="@Url.Action("AdminIndex", "Jobs")">Xem tất cả tin</a>
            }
            else
            {
                <a class="btn btn-primary" href="@Url.Action("Create", "Jobs")">Tạo tin đầu tiên</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive jobs-table-wrap">
            <table class="table ats-table jobs-table align-middle">
                <thead>
                    <tr>
                        <th>Tin tuyển dụng</th>
                        <th>Phòng ban &amp; vị trí</th>
                        <th>Địa điểm</th>
                        <th>Hồ sơ</th>
                        <th>Hạn nộp</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.Jobs)
                    {
                        var isExpired = job.Deadline.HasValue && job.Deadline.Value.Date < today;
                        var isExpiring = job.IsActive &&
                                         job.Deadline.HasValue &&
                                         job.Deadline.Value.Date >= today &&
                                         job.Deadline.Value.Date <= expiringThrough;
                        var statusClass = isExpired ? "badge-soft-danger" :
                                          isExpiring ? "badge-soft-warning" :
                                          job.IsActive ? "badge-soft-success" : "badge-soft-neutral";
                        var statusText = isExpired ? "Hết hạn" :
                                         isExpiring ? "Sắp hết hạn" :
                                         job.IsActive ? "Đang mở" : "Đã đóng";
                        var daysFromDeadline = job.Deadline.HasValue
                            ? (job.Deadline.Value.Date - today).Days
                            : (int?)null;
                        var deadlineNote = !daysFromDeadline.HasValue ? "Chưa đặt hạn" :
                                           daysFromDeadline.Value < 0 ? "Quá hạn " + Math.Abs(daysFromDeadline.Value) + " ngày" :
                                           daysFromDeadline.Value == 0 ? "Hết hạn hôm nay" :
                                           "Còn " + daysFromDeadline.Value + " ngày";

                        <tr>
                            <td data-label="Tin tuyển dụng">
                                <a class="job-title-link" href="@Url.Action("AdminPreview", "Jobs", new { id = job.JobID })">@job.Title</a>
                                <span class="table-subtitle">@(string.IsNullOrWhiteSpace(job.JobType) ? "Chưa cập nhật loại việc" : job.JobType)</span>
                            </td>
                            <td data-label="Phòng ban & vị trí">
                                <span class="job-department">@(string.IsNullOrWhiteSpace(job.DepartmentName) ? "Chưa có phòng ban" : job.DepartmentName)</span>
                                <span class="table-subtitle">@(string.IsNullOrWhiteSpace(job.PositionName) ? "Chưa có vị trí" : job.PositionName)</span>
                            </td>
                            <td data-label="Địa điểm">@(string.IsNullOrWhiteSpace(job.Location) ? "Chưa cập nhật" : job.Location)</td>
                            <td data-label="Hồ sơ">
                                <a class="job-application-count" href="@Url.Action("Index", "Applications", new { jobId = job.JobID })" aria-label="Xem @job.ApplicationCount hồ sơ của tin @job.Title">
                                    @job.ApplicationCount
                                    <span>hồ sơ</span>
                                </a>
                            </td>
                            <td data-label="Hạn nộp">
                                <time class="job-deadline" datetime="@(job.Deadline.HasValue ? job.Deadline.Value.ToString("yyyy-MM-dd") : null)">
                                    @(job.Deadline.HasValue ? job.Deadline.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")
                                </time>
                                <span class="job-deadline-note @(isExpired ? "is-overdue" : isExpiring ? "is-warning" : "")">@deadlineNote</span>
                            </td>
                            <td data-label="Trạng thái"><span class="@statusClass">@statusText</span></td>
                            <td class="text-end jobs-actions-cell" data-label="Thao tác">
                                <div class="job-row-actions">
                                    <a class="job-primary-action" href="@Url.Action("Index", "Applications", new { jobId = job.JobID })">Xem hồ sơ</a>
                                    <details class="job-actions-dropdown">
                                        <summary aria-label="Mở menu thao tác cho tin @job.Title">•••</summary>
                                        <div class="job-actions-menu">
                                            <a href="@Url.Action("AdminPreview", "Jobs", new { id = job.JobID })">Xem chi tiết</a>
                                            <a href="@Url.Action("Edit", "Jobs", new { id = job.JobID })">Chỉnh sửa</a>
                                            @if (isExpired)
                                            {
                                                <a href="@Url.Action("Edit", "Jobs", new { id = job.JobID })">Gia hạn tin</a>
                                            }
                                            else
                                            {
                                                using (Html.BeginForm("ToggleStatus", "Jobs", new { id = job.JobID }, FormMethod.Post, new
                                                {
                                                    @class = "job-menu-form",
                                                    data_confirm = "true",
                                                    data_confirm_title = job.IsActive ? "Đóng tin tuyển dụng?" : "Mở lại tin tuyển dụng?",
                                                    data_confirm_message = job.IsActive
                                                        ? "Tin sẽ ngừng nhận hồ sơ mới sau khi đóng."
                                                        : "Tin sẽ tiếp tục nhận hồ sơ nếu vẫn còn hạn nộp.",
                                                    data_confirm_action = job.IsActive ? "Đóng tin" : "Mở lại"
                                                }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit">@(job.IsActive ? "Đóng tin" : "Mở lại tin")</button>
                                                }
                                            }
                                            @using (Html.BeginForm("Delete", "Jobs", new { id = job.JobID }, FormMethod.Post, new
                                            {
                                                @class = "job-menu-form",
                                                data_confirm = "true",
                                                data_confirm_title = "Xóa tin tuyển dụng?",
                                                data_confirm_message = "Tin sẽ bị ẩn khỏi danh sách quản lý. Thao tác này không thể hoàn tác trên giao diện.",
                                                data_confirm_action = "Xóa tin",
                                                data_confirm_danger = "true"
                                            }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button class="is-danger" type="submit">Xóa tin</button>
                                            }
                                        </div>
                                    </details>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav class="admin-pagination" aria-label="Phân trang tin tuyển dụng">
            @if (Model.Page > 1)
            {
                <a href="@Url.Action("AdminIndex", "Jobs", new { keyword = Model.Keyword, departmentId = Model.DepartmentID, jobPositionId = Model.JobPositionID, location = Model.Location, jobType = Model.JobType, status = Model.Status, sort = Model.Sort, page = Model.Page - 1 })">Trước</a>
            }
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <a class="@(pageNumber == Model.Page ? "active" : null)"
                   aria-current="@(pageNumber == Model.Page ? "page" : null)"
                   href="@Url.Action("AdminIndex", "Jobs", new { keyword = Model.Keyword, departmentId = Model.DepartmentID, jobPositionId = Model.JobPositionID, location = Model.Location, jobType = Model.JobType, status = Model.Status, sort = Model.Sort, page = pageNumber })">@pageNumber</a>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <a href="@Url.Action("AdminIndex", "Jobs", new { keyword = Model.Keyword, departmentId = Model.DepartmentID, jobPositionId = Model.JobPositionID, location = Model.Location, jobType = Model.JobType, status = Model.Status, sort = Model.Sort, page = Model.Page + 1 })">Sau</a>
            }
        </nav>
    }
</section>
