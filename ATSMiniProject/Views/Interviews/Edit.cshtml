@model ATSMiniProject.ViewModels.Interviews.InterviewEditViewModel

@{
    ViewBag.Title = Model.IsEdit ? "Cập nhật lịch phỏng vấn" : "Tạo lịch phỏng vấn";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var actionName = Model.IsEdit ? "Edit" : "Create";
}

<div class="interview-editor-page">
    <div class="page-header interview-editor-header">
        <div>
            <a class="department-back-link" href="@Url.Action("Index", "Interviews")">
                <span aria-hidden="true">←</span>
                Danh sách phỏng vấn
            </a>
            <span class="admin-eyebrow">@(Model.IsEdit ? "Cập nhật lịch" : "Lịch phỏng vấn mới")</span>
            <h1>@ViewBag.Title</h1>
            <p>Sắp xếp lịch rõ ràng để HR, người phỏng vấn và ứng viên cùng theo dõi.</p>
        </div>
        @if (Model.IsEdit)
        {
            <a class="btn btn-outline-secondary" href="@Url.Action("Review", "Applications", new { id = Model.ApplicationId })">Xem hồ sơ ứng viên</a>
        }
    </div>

    <div class="interview-editor-layout">
        <section class="admin-panel interview-editor-card" aria-label="Biểu mẫu lịch phỏng vấn">
            @using (Html.BeginForm(actionName, "Interviews", FormMethod.Post, new { @class = "interview-editor-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.InterviewId)
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger interview-editor-summary" })

                <section class="interview-form-section" aria-labelledby="interview-candidate-heading">
                    <div class="admin-form-section-heading">
                        <span>01</span>
                        <div>
                            <h2 id="interview-candidate-heading">Hồ sơ ứng viên</h2>
                            <p>Chọn đúng hồ sơ cần sắp xếp lịch phỏng vấn.</p>
                        </div>
                    </div>

                    <div class="admin-form-grid">
                        <div class="form-field form-field-full">
                            @Html.LabelFor(model => model.ApplicationId, new { @class = "form-label" })
                            @if (Model.IsEdit)
                            {
                                @Html.HiddenFor(model => model.ApplicationId)
                                <input class="form-control interview-readonly-field" value="#@Model.ApplicationId.ToString("D4") · @Model.CandidateName · @Model.JobTitle" disabled />
                            }
                            else
                            {
                                @Html.DropDownListFor(model => model.ApplicationId, Model.ApplicationOptions, "Chọn hồ sơ ứng viên", new { @class = "form-select" })
                            }
                            @Html.ValidationMessageFor(model => model.ApplicationId, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                </section>

                <section class="interview-form-section" aria-labelledby="interview-schedule-heading">
                    <div class="admin-form-section-heading">
                        <span>02</span>
                        <div>
                            <h2 id="interview-schedule-heading">Thời gian và hình thức</h2>
                            <p>Thiết lập thời điểm, người phụ trách và nơi diễn ra buổi trao đổi.</p>
                        </div>
                    </div>

                    <div class="admin-form-grid">
                        <div class="form-field">
                            @Html.LabelFor(model => model.InterviewDate, new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.InterviewDate, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                            @Html.ValidationMessageFor(model => model.InterviewDate, "", new { @class = "text-danger small" })
                        </div>
                        <div class="form-field">
                            @Html.LabelFor(model => model.InterviewerUserId, new { @class = "form-label" })
                            @Html.DropDownListFor(model => model.InterviewerUserId, Model.InterviewerOptions, "Chưa phân công", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.InterviewerUserId, "", new { @class = "text-danger small" })
                        </div>
                        <div class="form-field form-field-full">
                            @Html.LabelFor(model => model.InterviewLocation, new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.InterviewLocation, new { @class = "form-control", placeholder = "VD: Phòng họp A101 hoặc đường dẫn Microsoft Teams" })
                            <small class="interview-field-hint">Có thể nhập phòng họp trực tiếp hoặc đường dẫn cuộc họp trực tuyến.</small>
                            @Html.ValidationMessageFor(model => model.InterviewLocation, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                </section>

                <section class="interview-form-section" aria-labelledby="interview-content-heading">
                    <div class="admin-form-section-heading">
                        <span>03</span>
                        <div>
                            <h2 id="interview-content-heading">Nội dung và kết quả</h2>
                            <p>Ghi nội dung cần chuẩn bị và cập nhật kết quả sau buổi phỏng vấn.</p>
                        </div>
                    </div>

                    <div class="admin-form-grid">
                        <div class="form-field form-field-full">
                            @Html.LabelFor(model => model.Note, new { @class = "form-label" })
                            @Html.TextAreaFor(model => model.Note, 5, 40, new { @class = "form-control", placeholder = "Vòng phỏng vấn, nội dung trao đổi, yêu cầu chuẩn bị..." })
                            @Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger small" })
                        </div>
                        @if (Model.IsEdit)
                        {
                            <div class="form-field form-field-full">
                                @Html.LabelFor(model => model.Result, new { @class = "form-label" })
                                @Html.DropDownListFor(model => model.Result, Model.ResultOptions, new { @class = "form-select" })
                                @Html.ValidationMessageFor(model => model.Result, "", new { @class = "text-danger small" })
                                <div class="form-text">Kết quả “Đạt” hoặc “Không đạt” sẽ đồng bộ trạng thái hồ sơ tương ứng.</div>
                            </div>
                        }
                        else
                        {
                            @Html.HiddenFor(model => model.Result)
                            <div class="form-field form-field-full">
                                <div class="admin-inline-note">Kết quả được cập nhật sau khi lịch phỏng vấn đã được tạo.</div>
                            </div>
                        }
                    </div>
                </section>

                <footer class="interview-editor-actions">
                    <span>Các thay đổi sẽ hiển thị trong khu vực theo dõi của ứng viên.</span>
                    <div>
                        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Interviews")">Hủy</a>
                        <button class="btn btn-primary" type="submit">@(Model.IsEdit ? "Lưu thay đổi" : "Tạo lịch phỏng vấn")</button>
                    </div>
                </footer>
            }
        </section>

        <aside class="interview-editor-aside" aria-label="Hướng dẫn tạo lịch phỏng vấn">
            <section class="admin-panel interview-guide-card">
                <span class="admin-eyebrow">Trước khi lưu</span>
                <h2>Kiểm tra lịch hẹn</h2>
                <ol class="interview-step-list">
                    <li>
                        <span>1</span>
                        <div><strong>Đúng ứng viên</strong><small>Kiểm tra hồ sơ và vị trí đang ứng tuyển.</small></div>
                    </li>
                    <li>
                        <span>2</span>
                        <div><strong>Đủ thông tin</strong><small>Xác nhận thời gian, người phỏng vấn và địa điểm.</small></div>
                    </li>
                    <li>
                        <span>3</span>
                        <div><strong>Sẵn sàng thông báo</strong><small>Nội dung đã rõ để ứng viên chuẩn bị.</small></div>
                    </li>
                </ol>
            </section>

            <section class="admin-panel interview-rules-card">
                <span class="admin-eyebrow">Nguyên tắc vận hành</span>
                <ul class="admin-check-list">
                    <li>Mỗi lịch gắn với đúng một hồ sơ ứng tuyển.</li>
                    <li>Không tạo hai lịch trùng thời điểm cho cùng hồ sơ.</li>
                    <li>Tạo lịch mới tự chuyển hồ sơ sang “Mời phỏng vấn”.</li>
                    <li>Mọi cập nhật đều được ghi vào nhật ký hệ thống.</li>
                </ul>
            </section>

            @if (Model.IsEdit)
            {
                <section class="admin-panel admin-danger-panel interview-cancel-card">
                    <span class="admin-eyebrow">Hủy lịch</span>
                    <h2>Không còn sử dụng lịch này?</h2>
                    <p>Lịch sẽ được hủy mềm và không còn hiển thị cho ứng viên.</p>
                    @using (Html.BeginForm("Cancel", "Interviews", new { id = Model.InterviewId }, FormMethod.Post, new
                    {
                        @class = "mt-3",
                        data_confirm = "true",
                        data_confirm_title = "Hủy lịch phỏng vấn",
                        data_confirm_message = "Lịch sẽ không còn hiển thị cho ứng viên sau khi hủy.",
                        data_confirm_action = "Hủy lịch",
                        data_confirm_danger = "true"
                    }))
                    {
                        @Html.AntiForgeryToken()
                        <button class="btn btn-outline-danger w-100" type="submit">Hủy lịch phỏng vấn</button>
                    }
                </section>
            }
        </aside>
    </div>
</div>
