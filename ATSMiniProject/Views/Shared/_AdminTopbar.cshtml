@{
    var fullName = Session["AuthFullName"] as string;
    var roleName = Session["AuthRoleName"] as string;
    var avatarPath = Session["AuthAvatarPath"] as string;
}

<header class="admin-topbar">
    <div class="admin-topbar-leading">
        <button class="admin-sidebar-toggle"
                type="button"
                aria-label="Thu gọn thanh chức năng"
                aria-controls="admin-sidebar"
                aria-expanded="true"
                data-sidebar-toggle>
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
        </button>
        <div class="admin-topbar-context">
            <span class="admin-context-mark" aria-hidden="true"></span>
            <span>
                <small>Không gian tuyển dụng</small>
                <strong>Điều hành quy trình ứng viên</strong>
            </span>
        </div>
    </div>
    <div class="admin-topbar-actions">
        @Html.Action("TopbarBell", "Notifications")
        <details class="admin-account-menu">
            <summary class="admin-user-chip" title="Mở menu tài khoản" aria-label="Mở menu tài khoản">
                @if (!string.IsNullOrWhiteSpace(avatarPath))
                {
                    <img class="admin-avatar admin-avatar-image" src="@Url.Content(avatarPath)" alt="Ảnh đại diện" />
                }
                else
                {
                    <span class="admin-avatar">@((string.IsNullOrWhiteSpace(fullName) ? "U" : fullName.Substring(0, 1)).ToUpperInvariant())</span>
                }
                <span class="admin-user-meta">
                    <strong>@(string.IsNullOrWhiteSpace(fullName) ? "Người dùng" : fullName)</strong>
                    <small>@(string.IsNullOrWhiteSpace(roleName) ? "User" : roleName)</small>
                </span>
                <svg class="admin-account-chevron" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m8 10 4 4 4-4"></path>
                </svg>
            </summary>

            <div class="admin-account-popover" role="menu">
                <a class="admin-account-menu-item" href="@Url.Action("Profile", "Account")" role="menuitem">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="8" r="4"></circle>
                        <path d="M5 20a7 7 0 0 1 14 0"></path>
                    </svg>
                    <span>Thông tin cá nhân</span>
                </a>
                @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "admin-account-logout" }))
                {
                    @Html.AntiForgeryToken()
                    <button class="admin-account-menu-item" type="submit" role="menuitem">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M10 5H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4"></path>
                            <path d="m15 8 4 4-4 4M9 12h10"></path>
                        </svg>
                        <span>Đăng xuất</span>
                    </button>
                }
            </div>
        </details>
    </div>
</header>
