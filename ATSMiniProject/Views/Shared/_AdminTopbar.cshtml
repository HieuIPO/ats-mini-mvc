@{
    var fullName = Session["AuthFullName"] as string;
    var roleName = Session["AuthRoleName"] as string;
    var avatarPath = Session["AuthAvatarPath"] as string;
}

<header class="admin-topbar">
    <div class="admin-topbar-search" role="search">
        <span class="search-dot"></span>
        <input type="search" class="form-control" placeholder="Tìm kiếm nhanh..." aria-label="Tìm kiếm nhanh" />
    </div>
    <div class="admin-topbar-actions">
        <button type="button" class="icon-btn" aria-label="Thông báo">!</button>
        <a class="admin-user-chip" href="@Url.Action("Profile", "Account")" title="Thông tin cá nhân">
            @if (!string.IsNullOrWhiteSpace(avatarPath))
            {
                <img class="admin-avatar admin-avatar-image" src="@Url.Content(avatarPath)" alt="Ảnh đại diện" />
            }
            else
            {
                <span class="admin-avatar">@((string.IsNullOrWhiteSpace(fullName) ? "U" : fullName.Substring(0, 1)).ToUpperInvariant())</span>
            }
            <span class="admin-user-meta">
                <strong>@(string.IsNullOrWhiteSpace(fullName) ? "Người dùng" : fullName)</strong>
                <small>@(string.IsNullOrWhiteSpace(roleName) ? "User" : roleName)</small>
            </span>
        </a>
        <a class="btn btn-outline-primary btn-sm" href="@Url.Action("Profile", "Account")">Thông tin cá nhân</a>
        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "d-inline" }))
        {
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-secondary btn-sm" type="submit">Đăng xuất</button>
        }
    </div>
</header>
