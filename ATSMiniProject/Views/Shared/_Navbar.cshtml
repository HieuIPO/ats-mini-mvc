@{
    var isLoggedIn = Session["AuthUserID"] != null;
    var fullName = Session["AuthFullName"] as string;
    var roleName = Session["AuthRoleName"] as string;
    var isBackOfficeUser = string.Equals(roleName, "Admin", System.StringComparison.OrdinalIgnoreCase)
        || string.Equals(roleName, "HR", System.StringComparison.OrdinalIgnoreCase);
    var isCandidate = string.Equals(roleName, "Candidate", System.StringComparison.OrdinalIgnoreCase);
}

<nav class="navbar navbar-expand-lg navbar-light public-navbar sticky-top">
    <div class="container">
        <a class="navbar-brand public-brand" href="@Url.Action("Index", "Home")">
            <span class="public-brand-mark">A</span>
            <span>ATS Mini</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNavbar" aria-controls="publicNavbar" aria-expanded="false" aria-label="Mo menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="publicNavbar">
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0 public-nav-list">
                <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Home")">Trang chu</a></li>
                <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Jobs")">Viec lam</a></li>
                @if (isCandidate)
                {
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Profile", "Candidate")">Ho so cua toi</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Status", "Applications")">Trang thai ung tuyen</a></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Status", "Applications")">Theo doi ho so</a></li>
                }
                @if (isBackOfficeUser)
                {
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Dashboard")">Dashboard</a></li>
                }
            </ul>
            <div class="d-flex align-items-center gap-2 public-nav-actions">
                @if (isLoggedIn)
                {
                    <span class="navbar-text small text-muted d-none d-lg-inline">@fullName (@roleName)</span>
                    using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button class="btn btn-outline-secondary btn-sm" type="submit">Dang xuat</button>
                    }
                }
                else
                {
                    <a class="btn btn-outline-primary btn-sm" href="@Url.Action("Login", "Account")">Dang nhap</a>
                }
            </div>
        </div>
    </div>
</nav>
