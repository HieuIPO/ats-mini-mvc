@{
    ViewBag.Title = "Nộp hồ sơ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="jobs-list-section">
    <div class="container">
        <div class="placeholder-card">
            <span class="eyebrow">Ứng tuyển</span>
            <h1>Form nộp hồ sơ đang được phát triển</h1>
            <p>Chức năng nộp hồ sơ thuộc Thành viên 3. Trang tạm này giúp nút “Ứng tuyển” không bị lỗi trong lúc ghép bài.</p>
            @if (ViewBag.JobID != null)
            {
                <p class="text-muted">Mã tin tuyển dụng: <strong>@ViewBag.JobID</strong></p>
                <a class="btn btn-outline-primary" href="@Url.Action("Details", "Jobs", new { id = ViewBag.JobID })">Quay lại tin tuyển dụng</a>
            }
            <a class="btn btn-primary" href="@Url.Action("Index", "Jobs")">Xem việc làm khác</a>
        </div>
    </div>
</section>
