@model ATSMiniProject.ViewModels.Applications.CandidateApplicationDetailsViewModel

@{
    ViewBag.Title = "Chi tiết hồ sơ";
}

<section class="candidate-section application-detail-page">
    <div class="container">
        <a class="candidate-back-link" href="@Url.Action("Status", "Applications")"><span aria-hidden="true">←</span> Tất cả hồ sơ</a>
        <div class="application-detail-header">
            <div>
                <span class="status-badge @(Model.IsFinal ? "status-final" : null)">@Model.StatusName</span>
                <h1>@Model.JobTitle</h1>
                <p>@Model.DepartmentName · @Model.PositionName · @(Model.Location ?? "Chưa cập nhật địa điểm")</p>
            </div>
            <a class="btn btn-outline-primary" href="@Url.Action("Details", "Jobs", new { id = Model.JobId })">Xem tin tuyển dụng</a>
        </div>

        <div class="application-detail-layout">
            <div>
                <section class="candidate-panel status-progress-panel">
                    <div class="panel-heading">
                        <span class="eyebrow">Tiến trình tuyển dụng</span>
                        <h2>Lịch sử trạng thái</h2>
                    </div>
                    <div class="status-timeline">
                        @foreach (var history in Model.StatusHistory)
                        {
                            <div class="status-timeline-item">
                                <span></span>
                                <div>
                                    <strong>@history.StatusName</strong>
                                    <small>@history.ChangedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            </div>
                        }
                    </div>
                </section>

                <section class="candidate-panel interview-panel">
                    <div class="panel-heading">
                        <span class="eyebrow">Trao đổi trực tiếp</span>
                        <h2>Lịch phỏng vấn</h2>
                    </div>
                    @if (Model.Interviews.Count == 0)
                    {
                        <div class="inline-empty">
                            <strong>Chưa có lịch phỏng vấn</strong>
                            <span>Thông tin sẽ xuất hiện tại đây khi nhà tuyển dụng cập nhật.</span>
                        </div>
                    }
                    else
                    {
                        foreach (var interview in Model.Interviews)
                        {
                            var hasResult = !string.IsNullOrWhiteSpace(interview.Result);
                            var isUpcoming = interview.InterviewDate >= DateTime.Now;
                            var stateClass = hasResult
                                ? "candidate-interview-state--complete"
                                : isUpcoming
                                    ? "candidate-interview-state--upcoming"
                                    : "candidate-interview-state--waiting";
                            var stateText = hasResult
                                ? "Đã có kết quả"
                                : isUpcoming
                                    ? "Sắp diễn ra"
                                    : "Chờ cập nhật kết quả";

                            <article class="candidate-interview-card">
                                <time class="candidate-interview-card__date"
                                      datetime="@interview.InterviewDate.ToString("yyyy-MM-ddTHH:mm:ss")">
                                    <strong>@interview.InterviewDate.ToString("dd")</strong>
                                    <span>Tháng @interview.InterviewDate.ToString("MM")</span>
                                    <small>@interview.InterviewDate.ToString("yyyy")</small>
                                </time>

                                <div class="candidate-interview-card__content">
                                    <div class="candidate-interview-card__heading">
                                        <strong>@interview.InterviewDate.ToString("dd/MM/yyyy") lúc @interview.InterviewDate.ToString("HH:mm")</strong>
                                        <span class="candidate-interview-state @stateClass">@stateText</span>
                                    </div>

                                    <dl class="candidate-interview-card__details">
                                        <div>
                                            <dt>Địa điểm:</dt>
                                            <dd>@(string.IsNullOrWhiteSpace(interview.Location) ? "Sẽ được cập nhật" : interview.Location)</dd>
                                        </div>
                                    </dl>

                                    @if (hasResult)
                                    {
                                        <p class="candidate-interview-card__result">
                                            <span>Kết quả:</span>
                                            <strong>@interview.Result</strong>
                                        </p>
                                    }
                                </div>

                                @if (interview.CanAddToCalendar)
                                {
                                    <a class="candidate-interview-card__action"
                                       href="@Url.Action("DownloadInterviewCalendar", "Applications", new { id = interview.InterviewId })">
                                        <span aria-hidden="true">＋</span>
                                        Thêm vào lịch
                                    </a>
                                }
                            </article>
                        }
                    }
                </section>
            </div>

            <aside class="candidate-panel application-summary-panel">
                <div class="panel-heading">
                    <span class="eyebrow">Hồ sơ đã gửi</span>
                    <h2>Thông tin ứng tuyển</h2>
                </div>
                <dl class="candidate-summary">
                    <div><dt>Ứng viên</dt><dd>@Model.CandidateName</dd></div>
                    <div><dt>Email</dt><dd>@Model.CandidateEmail</dd></div>
                    <div><dt>Điện thoại</dt><dd>@Model.CandidatePhone</dd></div>
                    <div><dt>Ngày nộp</dt><dd>@Model.AppliedDate.ToString("dd/MM/yyyy HH:mm")</dd></div>
                </dl>
                @if (Model.CandidateFileId.HasValue)
                {
                    <a class="btn btn-outline-primary w-100" href="@Url.Action("DownloadCv", "Applications", new { id = Model.CandidateFileId })">
                        Tải CV · @Model.CvOriginalFileName
                    </a>
                }
            </aside>
        </div>
    </div>
</section>
