@model ATSMiniProject.ViewModels.Jobs.JobPositionFormViewModel
@{
    ViewBag.Title = "Thêm vị trí";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="department-form-page job-position-form-page">
    <div class="page-header department-form-page-header">
        <div>
            <a class="department-back-link" href="@Url.Action("Index", "JobPositions")">
                <span aria-hidden="true">←</span>
                Danh sách vị trí
            </a>
            <h1>Thêm vị trí tuyển dụng</h1>
            <p>Tạo chức danh mới để sử dụng trong tin tuyển dụng.</p>
        </div>
    </div>

    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "department-form-frame" }))
    {
        @Html.AntiForgeryToken()
        @Html.Partial("_Form", Model)
        <footer class="department-form-footer">
            <p><span aria-hidden="true">*</span> Trường bắt buộc</p>
            <div class="department-form-actions">
                <a class="btn btn-outline-secondary" href="@Url.Action("Index", "JobPositions")">Huỷ</a>
                <button class="btn btn-primary" type="submit">Lưu vị trí</button>
            </div>
        </footer>
    }
</div>
