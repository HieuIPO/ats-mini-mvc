@model ATSMiniProject.ViewModels.Jobs.JobPositionFormViewModel

@Html.HiddenFor(m => m.JobPositionID)
@Html.ValidationSummary(true, "", new { @class = "text-danger department-form-summary" })

<section class="department-form-main" aria-labelledby="job-position-info-heading">
    <header class="department-form-section-header">
        <span aria-hidden="true">01</span>
        <div>
            <h2 id="job-position-info-heading">Thông tin vị trí</h2>
            <p>Tên và mô tả sẽ hiển thị trong danh mục quản trị.</p>
        </div>
    </header>

    <div class="department-form-fields">
        <div class="department-form-field">
            <label class="form-label" for="PositionName">
                Tên vị trí <span class="department-required-mark" aria-hidden="true">*</span>
            </label>
            @Html.TextBoxFor(m => m.PositionName, new
            {
                @class = "form-control",
                placeholder = "VD: Lập trình viên Web",
                maxlength = "100",
                autocomplete = "organization-title"
            })
            <small class="department-field-hint">Dùng tên chức danh ngắn, rõ ràng và không trùng với vị trí hiện có.</small>
            @Html.ValidationMessageFor(m => m.PositionName, "", new { @class = "text-danger" })
        </div>

        <div class="department-form-field">
            @Html.LabelFor(m => m.Description, new { @class = "form-label" })
            @Html.TextAreaFor(m => m.Description, 5, 40, new
            {
                @class = "form-control",
                placeholder = "VD: Phát triển và duy trì các ứng dụng web nội bộ.",
                maxlength = "255"
            })
            <small class="department-field-hint">Tối đa 255 ký tự. Nêu ngắn gọn phạm vi công việc của vị trí.</small>
            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
        </div>
    </div>
</section>

<aside class="department-form-side" aria-labelledby="job-position-status-heading">
    <header class="department-form-section-header">
        <span aria-hidden="true">02</span>
        <div>
            <h2 id="job-position-status-heading">Trạng thái sử dụng</h2>
            <p>Kiểm soát việc vị trí xuất hiện trong các biểu mẫu.</p>
        </div>
    </header>

    <div class="department-status-control">
        <div>
            <strong>Đang sử dụng</strong>
            <small id="job-position-status-help">Cho phép chọn vị trí này khi tạo hoặc sửa tin tuyển dụng.</small>
        </div>
        <div class="form-check form-switch">
            @Html.CheckBoxFor(m => m.IsActive, new
            {
                @class = "form-check-input",
                aria_label = "Đang sử dụng vị trí tuyển dụng",
                aria_describedby = "job-position-status-help"
            })
        </div>
    </div>

    <div class="department-status-note">
        <strong>Lưu ý</strong>
        <p>Tạm dừng vị trí không làm mất các tin tuyển dụng đã liên kết trước đó.</p>
    </div>
</aside>
