@model ATSMiniProject.ViewModels.Jobs.DepartmentFormViewModel
@{
    ViewBag.Title = "Sửa phòng ban";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="department-form-page">
    <div class="page-header department-form-page-header">
        <div>
            <a class="department-back-link" href="@Url.Action("Index", "Departments")">
                <span aria-hidden="true">←</span>
                Danh sách phòng ban
            </a>
            <h1>Sửa phòng ban</h1>
            <p>Cập nhật thông tin và trạng thái sử dụng của phòng ban.</p>
        </div>
    </div>

    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "department-form-frame" }))
    {
        @Html.AntiForgeryToken()
        @Html.Partial("_Form", Model)
        <footer class="department-form-footer">
            <p><span aria-hidden="true">*</span> Trường bắt buộc</p>
            <div class="department-form-actions">
                <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Departments")">Huỷ</a>
                <button class="btn btn-primary" type="submit">Lưu thay đổi</button>
            </div>
        </footer>
    }
</div>
