@model ATSMiniProject.ViewModels.Jobs.DepartmentFormViewModel

@Html.HiddenFor(m => m.DepartmentID)
@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<div class="row g-3">
    <div class="col-md-8">
        @Html.LabelFor(m => m.DepartmentName, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.DepartmentName, new { @class = "form-control", placeholder = "VD: Phòng Công nghệ thông tin" })
        @Html.ValidationMessageFor(m => m.DepartmentName, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.IsActive, new { @class = "form-label d-block" })
        <div class="form-check form-switch mt-2">
            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
            <label class="form-check-label" for="IsActive">Đang sử dụng</label>
        </div>
    </div>
    <div class="col-12">
        @Html.LabelFor(m => m.Description, new { @class = "form-label" })
        @Html.TextAreaFor(m => m.Description, 4, 40, new { @class = "form-control", placeholder = "Mô tả ngắn về phòng ban" })
        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
    </div>
</div>
