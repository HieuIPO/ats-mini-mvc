@model ATSMiniProject.ViewModels.Jobs.DepartmentFormViewModel

@Html.HiddenFor(m => m.DepartmentID)
@Html.ValidationSummary(true, "", new { @class = "text-danger department-form-summary" })

<section class="department-form-main" aria-labelledby="department-info-heading">
    <header class="department-form-section-header">
        <span aria-hidden="true">01</span>
        <div>
            <h2 id="department-info-heading">Thông tin phòng ban</h2>
            <p>Tên và mô tả sẽ hiển thị trong danh mục quản trị.</p>
        </div>
    </header>

    <div class="department-form-fields">
        <div class="department-form-field">
            <label class="form-label" for="DepartmentName">
                Tên phòng ban <span class="department-required-mark" aria-hidden="true">*</span>
            </label>
            @Html.TextBoxFor(m => m.DepartmentName, new
            {
                @class = "form-control",
                placeholder = "VD: Phòng Công nghệ thông tin",
                maxlength = "100",
                autocomplete = "organization"
            })
            <small class="department-field-hint">Dùng tên ngắn, rõ ràng và không trùng với phòng ban hiện có.</small>
            @Html.ValidationMessageFor(m => m.DepartmentName, "", new { @class = "text-danger" })
        </div>

        <div class="department-form-field">
            @Html.LabelFor(m => m.Description, new { @class = "form-label" })
            @Html.TextAreaFor(m => m.Description, 5, 40, new
            {
                @class = "form-control",
                placeholder = "VD: Phụ trách phát triển sản phẩm và vận hành hệ thống nội bộ.",
                maxlength = "255"
            })
            <small class="department-field-hint">Tối đa 255 ký tự. Nêu ngắn gọn chức năng chính của phòng ban.</small>
            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
        </div>
    </div>
</section>

<aside class="department-form-side" aria-labelledby="department-status-heading">
    <header class="department-form-section-header">
        <span aria-hidden="true">02</span>
        <div>
            <h2 id="department-status-heading">Trạng thái sử dụng</h2>
            <p>Kiểm soát việc phòng ban xuất hiện trong các biểu mẫu.</p>
        </div>
    </header>

    <div class="department-status-control">
        <div>
            <strong>Đang sử dụng</strong>
            <small id="department-status-help">Cho phép chọn phòng ban này khi tạo hoặc sửa tin tuyển dụng.</small>
        </div>
        <div class="form-check form-switch">
            @Html.CheckBoxFor(m => m.IsActive, new
            {
                @class = "form-check-input",
                aria_label = "Đang sử dụng phòng ban",
                aria_describedby = "department-status-help"
            })
        </div>
    </div>

    <div class="department-status-note">
        <strong>Lưu ý</strong>
        <p>Tạm dừng phòng ban không làm mất các tin tuyển dụng đã liên kết trước đó.</p>
    </div>
</aside>
